extends layout.pug

block content
   
    //script(src="assets/mqttws31.min.js")
    div(style='padding-top: 56px;').container-xxl
        .row.row-cols-1.row-cols-xl-2
            .col.mt-4
                include cards/playerCard.pug
            .col.mt-4
                include cards/time_and_statusCard.pug

        .card.text-center.mt-4.card_shadow
            .card-header
                ul#myNavTabs.nav.nav-tabs.card-header-tabs
                    li.nav-item
                        a#screenshotTab_bt.nav-link.active(aria-current='true' data-toggle="tab" href="#screenshot") Screenshot
                    li.nav-item
                        a#logTab_bt.nav-link(data-toggle="tab" href="#logs") Log
                    button#refresh_btn.btn.btn-secondary.m-2(type='button' class="position-absolute top-0 end-0") Refresh

            .card-body
                #screenshot.tab-pane.fade.show.active
                    img#screenshot.card-img-top(src='/get_screenshot' href=src style = "object-fit: contain;")
                #logs.tab-pane.fade
                    ul.nav.nav-tabs
                        li.nav-item
                            a.nav-link.active(data-toggle="tab" href="#scheduler-log") Scheduler
                        li.nav-item
                            a.nav-link(data-toggle="tab" href="#webka-log") WebKa
                        li.nav-item
                            a.nav-link(data-toggle="tab" href="#player-log") Player
                        li.nav-item
                            a.nav-link(data-toggle="tab" href="#supervisor-log") Supervisor
                        li.nav-item
                            a.nav-link(data-toggle="tab" href="#screen-sound-log") Screen Sound
                        li.nav-item
                            a.nav-link(data-toggle="tab" href="#usb-storage-log") USB Storage
                        li.nav-item
                            a.nav-link(data-toggle="tab" href="#uart2mqtt-log") UART2MQTT
                    .tab-content.mt-3
                        #scheduler-log.tab-pane.fade.show.active
                            pre#scheduler-log-content(style="height: 500px; overflow-y: auto; white-space: pre-wrap; font-family: monospace; text-align: left;")
                        #webka-log.tab-pane.fade
                            pre#webka-log-content(style="height: 500px; overflow-y: auto; white-space: pre-wrap; font-family: monospace; text-align: left;")
                        #player-log.tab-pane.fade
                            pre#player-log-content(style="height: 500px; overflow-y: auto; white-space: pre-wrap; font-family: monospace; text-align: left;")
                        #supervisor-log.tab-pane.fade
                            pre#supervisor-log-content(style="height: 500px; overflow-y: auto; white-space: pre-wrap; font-family: monospace; text-align: left;")
                        #screen-sound-log.tab-pane.fade
                            pre#screen-sound-log-content(style="height: 500px; overflow-y: auto; white-space: pre-wrap; font-family: monospace; text-align: left;")
                        #usb-storage-log.tab-pane.fade
                            pre#usb-storage-log-content(style="height: 500px; overflow-y: auto; white-space: pre-wrap; font-family: monospace; text-align: left;")
                        #uart2mqtt-log.tab-pane.fade
                            pre#uart2mqtt-log-content(style="height: 500px; overflow-y: auto; white-space: pre-wrap; font-family: monospace; text-align: left;")
                

    //script(src="assets/home.js")
    script.
        let config = !{JSON.stringify(config)}
        var activeTab = 'screenshot'
        //var screenshotTab = new bootstrap.Tab(document.querySelector('#screenshotTab'))
        //var logTab = new bootstrap.Tab(document.querySelector('#logTab'))

        let logInterval;

        function image_update(){
            console.log( "show screenshot!" );
            $("#logs").hide()
            $("#screenshot").show()
            if (logInterval) {
                clearInterval(logInterval);
                logInterval = null;
            }
            $("#screenshot").attr('src','/get_screenshot?rand=' + Math.random())
        }

        function load_logs() {
            const logFiles = ['scheduler.log', 'webKa.log', 'player_log.log', 'supervisor.log', 'screen_sound_config.log', 'usb_storage.log', 'uart2mqtt.log'];
            const logIds = ['scheduler-log-content', 'webka-log-content', 'player-log-content', 'supervisor-log-content', 'screen-sound-log-content', 'usb-storage-log-content', 'uart2mqtt-log-content'];
            logFiles.forEach((file, index) => {
                fetch(`/api/logs/${file}`)
                .then(response => response.text())
                .then(data => {
                    const lines = data.split('\n');
                    const reversedLines = lines.reverse();
                    $(`#${logIds[index]}`).html(reversedLines.join('\n'));
                })
                .catch(err => console.error(`Error loading ${file}:`, err));
            });
        }

        function show_log(){
            console.log( "show logs!" );
            $("#screenshot").hide()
            $("#logs").show()
            $("#refresh_spn").show();
            load_logs();
            $("#refresh_spn").hide();
            if (!logInterval) {
                logInterval = setInterval(load_logs, 2000);
            }
        }
    

        $("#myNavTabs a").click(function (evt) {
            evt.preventDefault();
            $(this).tab('show');
            
        });

        $("#logTab_bt").click(function() {
            activeTab = 'log'
            show_log()
        });

        $("#screenshotTab_bt").click(function() { 
            activeTab = 'screenshot'
            image_update()
        });

        // Handle inner log tabs
        $("#logs .nav-tabs a").click(function (evt) {
            evt.preventDefault();
            $(this).tab('show');
        });

        $("#refresh_btn").click(function() {
            if(activeTab == 'screenshot'){
                image_update()
            }
        });
        

        
            
        


script. 
  var date

  $(document).ready(function() {
    if(config.security.auth==1){
      document.getElementById("bt_logout").disabled = false
    }else{
      document.getElementById("bt_logout").disabled = true
    }

    fetch(`/get_date`, {
            method: 'GET',
            headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/json'
            }
            }).then((res) => res.json()
            ).then((dat) => {
                
                date =dat.d+"-"+dat.m+"-"+ dat.y
                //console.log(date)
                $('#MyClockDisplay').tooltip("dispose");
                $('#MyClockDisplay') .tooltip({
                      title: date
                  });
                //$('#MyClockDisplay').attr('data-original-title', date)
            })

  }); 

  

  function showTime(){
    var h // 0 - 23
    var m // 0 - 59
    var session = "AM";

    fetch(`/get_time`, {
      method: 'GET',
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/json'
      }
        }).then((res) => res.json()
        ).then((dat) => {
          //console.log("GET time, res: "+ dat.h+":"+dat.m) 
          
          h=dat.h
          m=dat.m

          if(h == 0){
            h = 12;
          }

          if(h > 12){
            h = h - 12;
            session = "PM";
          }

          h = (h < 10) ? "0" + h : h;
          m = (m < 10) ? "0" + m : m;

          var time = h + ":" + m + " " + session;
          document.getElementById("MyClockDisplay").innerText = time;
          document.getElementById("MyClockDisplay").textContent = time;

          setTimeout(showTime, 10000); 
      }).catch((err) => {
        console.log(err)
      })
  }

  showTime();  


        function getCurrentFolderPath(){
            let pathname = window.location.pathname
            if (!pathname.endsWith('/')) pathname += '/'
            return pathname
        }

        function getRelativeFilePath(file_name){
            const currentFolder = getCurrentFolderPath().replace(/^\/data\/?/, '')
            return currentFolder ? `${currentFolder}${file_name}` : file_name
        }

        function fileUrl(file_name){
            return getCurrentFolderPath() + encodeURIComponent(file_name)
        }

        function openPreviewModal(file_name, file_type){
            const title = document.getElementById('previewModalTitle')
            const body = document.getElementById('previewBody')
            title.textContent = `Preview: ${file_name}`
            body.innerHTML = ''
            const url = fileUrl(file_name)
            if (file_type === 'pic') {
                body.innerHTML = `<img src="${url}" class="img-fluid" style="max-height:70vh; width:auto;" />`
            } else if (file_type === 'video') {
                body.innerHTML = `<video controls class="w-100" style="max-height:70vh;"><source src="${url}"></video>`
            } else if (file_type === 'sound') {
                body.innerHTML = `<audio controls class="w-100"><source src="${url}"></audio>`
            } else if (file_type === 'script' || file_type === 'json') {
                body.innerHTML = `<div class="mb-2">Text preview</div><pre id="previewText" class="p-2 bg-light border rounded" style="max-height:65vh; overflow:auto; white-space: pre-wrap; word-break: break-word"></pre>`
                fetch(url)
                    .then((res) => res.text())
                    .then((text) => {
                        document.getElementById('previewText').textContent = text
                    })
                    .catch((err) => {
                        document.getElementById('previewText').textContent = 'Error loading preview: ' + err
                    })
            } else {
                body.innerHTML = `<p>No preview available for this file type.</p>`
            }
            if (window.modalManager) {
                modalManager.show('previewModal')
            } else {
                $('#previewModal').modal('show')
            }
        }

        function openEditModal(file_name){
            editFileName = file_name
            const title = document.querySelector('#editModal .modal-title')
            const textarea = document.getElementById('edit_file_content')
            title.textContent = `Edit: ${file_name}`
            textarea.value = ''
            fetch(fileUrl(file_name))
                .then((res) => res.text())
                .then((text) => {
                    textarea.value = text
                })
                .catch((err) => {
                    textarea.value = 'Error loading file: ' + err
                })
            if (window.modalManager) {
                modalManager.show('editModal')
            } else {
                $('#editModal').modal('show')
            }
        }

        function getEditPath(file_name){
            const currentFolder = getCurrentFolderPath().replace(/\/data\/?/, '')
            const encodedName = encodeURIComponent(file_name)
            return `/data/${currentFolder}${encodedName}@edit`
        }

        async function saveEditFile(){
            const textarea = document.getElementById('edit_file_content')
            const content = textarea.value
            const editPath = getEditPath(editFileName)
            try {
                const res = await fetch(editPath, {
                    method: 'POST',
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ content })
                })
                if (!res.ok) {
                    const err = await res.text()
                    alert('Save failed: ' + err)
                    return
                }
                if (window.modalManager) {
                    modalManager.hide('editModal')
                } else {
                    $('#editModal').modal('hide')
                }
                window.location.reload()
            } catch (e) {
                alert('Save failed: ' + e)
            }
        }







    
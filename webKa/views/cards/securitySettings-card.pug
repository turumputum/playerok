card.card(style='width: 620px;').card_shadow.h-100 
    .card-body
        h5.card-title Настройки безопасности
        p.card-text
    ul.list-group.list-group-flush
        li.list-group-item 
            .row.mt-2
                .col
                    .row.mb-2
                        .col
                            span.input-group-text(style='width:8em;' data-bs-toggle="tooltip" data-bs-placement="bottom" title="Аутентификация для доступа к панели управления") Авторизация
                        .col(style='transform: translate(-15px, 3px);')
                            input#turnOff_toggle(type='checkbox' data-toggle="toggle" data-size="sm" data-on='Вкл' data-off='Выкл')

                    .row.mb-2
                        .col
                            span.input-group-text(style='width:8em;') Включить SSH
                        .col(style='transform: translate(-15px, 3px);')
                            input#enableSSH_toggle(type='checkbox' data-toggle="toggle" data-size="sm" data-on='Вкл' data-off='Выкл')

                    .row.mb-2
                        .col
                            span.input-group-text(style='width:8em;' data-bs-toggle="tooltip" data-bs-placement="bottom" title="Требовать пароль для подключения к MQTT-брокеру") Пароль MQTT
                        .col(style='transform: translate(-15px, 3px);')
                            input#enableMQTT_toggle(type='checkbox' data-toggle="toggle" data-size="sm" data-on='Вкл' data-off='Выкл')

                    
                .col
                    .row.mb-2
                        .input-group
                            label.input-group-text(for='inputGroupSelect01' style='width:8em;') Логин
                            input#inputLogin_auth.form-control(type='text' disabled)

                    .row.mb-2
                        .input-group
                            label.input-group-text(for='inputGroupSelect01' style='width:8em;') Пароль
                            input#inputPassword_auth.form-control(type='password' )

                //- .col
                //-     .row.mb-2
                //-         .input-group
                //-             label.input-group-text(for='inputGroupSelect01' style='width:9em;') MQTT login
                //-             input#inputLogin_MQTT.form-control(type='text' disabled)

                //-     .row.mb-2
                //-         .input-group
                //-             label.input-group-text(for='inputGroupSelect01' style='width:9em;') MQTT password
                //-             input#inputPassword_MQTT.form-control(type='text' disabled)

            

    .card-body
        button.btn.btn-outline-secondary(type='button' onclick='save_security_settings()') Сохранить

    #confirm_save_security_config_modal.modal.modal-m.fade(tabindex='-1' aria-labelledby='confirm_save_security_config_modal' aria-hidden='true' data-bs-backdrop="static")
        .modal-dialog.modal-dialog-centered
            .modal-content
                .modal-header(style='background-color: rgb(177, 220, 226);')
                    h4.confirm_save_net_config_modal_title Сохранить настройки безопасности
                .modal-body
                    h4 Устройство будет перезагружено!

                .modal-footer
                    button.btn.btn-secondary(onclick = 'save_security_settings()') Ок
                    button.btn.btn-secondary(onclick = 'cancel_security_config()') Отмена

script.
    
    $( document ).ready(function(){
        //console.log('qu')
        if(config.security.auth==1){
            $('#turnOff_toggle').bootstrapToggle('on')
        }else{
            $('#turnOff_toggle').bootstrapToggle('off')
        }

        if(config.security.SSH==1){
            $('#enableSSH_toggle').bootstrapToggle('on')
        }else{
            $('#enableSSH_toggle').bootstrapToggle('off')
        }

        // MQTT password: default ON when the flag is absent (broker auth was
        // enabled by mqtt_auth_enable.sh and is the recommended state).
        if(config.security.MQTT==0){
            $('#enableMQTT_toggle').bootstrapToggle('off')
        }else{
            $('#enableMQTT_toggle').bootstrapToggle('on')
        }

        $('#inputLogin_auth').val(config.security.admin_login)
        $('#inputPassword_auth').val(config.security.admin_pass)
    })

    function cancel_security_config(){
        $('#confirm_save_security_config_modal').modal('hide')
    }

    function save_security_settings(){
        //$('#confirm_save_security_config_modal').modal('hide')

        config.security.auth = +$('#turnOff_toggle').prop('checked')
        config.security.SSH = +$('#enableSSH_toggle').prop('checked')
        config.security.MQTT = +$('#enableMQTT_toggle').prop('checked')
        config.security.admin_pass = $('#inputPassword_auth').val()
        fetch_save_config()
    }
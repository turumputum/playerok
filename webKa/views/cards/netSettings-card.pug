.card(style='width: 935px;').card_shadow.h-100 
    //66rem
    //img.align-center.card-img-top(class="center-block" src='icons/ip-address.png' style='margin-top: 1em; height: 6em; width:6em;' )
    .card-body
        .row
            .col
                h5.card-title Сетевые настройки
                p.card-text
            .col
                .input-group.mb-1
                    span#basic-addon1.input-group-text(style='width:8em;') Имя устройства
                    input#mDNS.form-control(type='text' placeholder= config.net.mDNS_name aria-label='mdnsName' aria-describedby='basic-addon1')

        //| Some quick example text to build on the card title and make up the bulk of the card&apos;s content.
    ul.list-group.list-group-flush
        .row.m-1.g-2
            .col(style='width: 300px;')
                //.m-3(style='width: 25rem;')
                li.list-group-item 
                    .row.mb-2
                        .col-6
                            span.input-group-text(style='width:7em;') Ethernet 0
                        .col(style='transform: translate(-15px, 2px);')                    
                            input#eth0_enable_toggle(type='checkbox' data-toggle="toggle" data-size="sm" data-onlabel='Вкл' data-offlabel='Выкл') 
                        .col 
                            i#eth0_carrier.bi.bi-ethernet(style="font-size: 25px;")
                    .row.mb-2
                        .col
                            span.input-group-text(style='width:7em;') DHCP
                        .col(style='transform: translate(-15px, 2px);')                     
                            input#eth0_DHCP_enable_toggle(type='checkbox' data-toggle="toggle" data-size="sm" data-onlabel='Вкл' data-offlabel='Выкл') 
                    .input-group.mb-2
                        span#basic-addon1.input-group-text(style='width:7em;') IP-адрес
                        input#eth0_ip_adress.form-control(type='text')
                    .input-group.mb-2
                        span#basic-addon1.input-group-text(style='width:7em;') Маска сети
                        input#eth0_net_mask.form-control(type='text')
                    .input-group.mb-2
                        span#basic-addon1.input-group-text(style='width:7em;') Шлюз
                        input#eth0_gateway.form-control(type='text')
                    .input-group.mb-2
                        span#basic-addon1.input-group-text(style='width:7em;') DNS
                        input#eth0_dns.form-control(type='text') 
            
            .col(style='width: 300px;')
                //.m-3(style='width: 20rem;')
                li.list-group-item 
                    .row.mb-2
                        .col-6
                            span.input-group-text(style='width:7em;') Ethernet 1
                        .col(style='transform: translate(-15px, 2px);')                      
                            input#eth1_enable_toggle(type='checkbox' data-toggle="toggle" data-size="sm" data-onlabel='Вкл' data-offlabel='Выкл') 
                        .col 
                            i#eth1_carrier.bi.bi-ethernet(style="font-size: 25px;" disabled=true)
                    .row.mb-2
                        .col
                            span.input-group-text(style='width:7em;') DHCP
                        .col(style='transform: translate(-15px, 2px);')                     
                            input#eth1_DHCP_enable_toggle(type='checkbox' data-toggle="toggle" data-size="sm" data-onlabel='Вкл' data-offlabel='Выкл') 
                    .input-group.mb-2
                        span#basic-addon1.input-group-text(style='width:7em;') IP-адрес
                        input#eth1_ip_adress.form-control(type='text')
                    .input-group.mb-2
                        span#basic-addon1.input-group-text(style='width:7em;') Маска сети
                        input#eth1_net_mask.form-control(type='text')
                    .input-group.mb-2
                        span#basic-addon1.input-group-text(style='width:7em;') Шлюз
                        input#eth1_gateway.form-control(type='text')
                    .input-group.mb-2
                        span#basic-addon1.input-group-text(style='width:7em;') DNS
                        input#eth1_dns.form-control(type='text') 
            
            .col(style='width: 300px;')
                //.m-3(style='width: 20rem;')
                li.list-group-item 
                    .row.mb-2
                        .col-6
                            span.input-group-text(style='width:7em;') Wi-Fi
                        .col(style='transform: translate(-15px, 2px);')                     
                            input#wlan0_enable_toggle(type='checkbox' data-toggle="toggle" data-size="sm" data-onlabel='Вкл' data-offlabel='Выкл') 
                        .col
                            i#wifi_sig_high.bi.bi-wifi(style="font-size: 25px;" disabled=true)
                            i#wifi_sig_mid.bi.bi-wifi-2(style="font-size: 25px;" disabled=true)
                            i#wifi_sig_low.bi.bi-wifi-1(style="font-size: 25px;" disabled=true)
                            i#wifi_sig_none.bi.bi-wifi-off(style="font-size: 25px;" disabled=true)
                    .input-group.mb-2
                        span#basic-addon1.input-group-text(style='width:7em;') SSID
                        input#wlan0_SSID.form-control(type='text' placeholder=config.net.wlan0.SSID)
                    .input-group.mb-2
                        span#basic-addon1.input-group-text(style='width:7em;') Пароль
                        input#wlan0_password.form-control(type='password' placeholder= "")
                    
                    .row.mb-2
                        .col
                            span.input-group-text(style='width:7em;') DHCP
                        .col(style='transform: translate(-15px, 2px);')                    
                            input#wlan0_DHCP_enable_toggle(type='checkbox' data-toggle="toggle" data-size="sm" data-onlabel='Вкл' data-offlabel='Выкл') 
                    .input-group.mb-2
                        span#basic-addon1.input-group-text(style='width:7em;') IP-адрес
                        input#wlan0_ip_adress.form-control(type='text' aria-label='IP_adress' aria-describedby='basic-addon1')
                    .input-group.mb-2
                        span#basic-addon1.input-group-text(style='width:7em;') Маска сети
                        input#wlan0_net_mask.form-control(type='text' aria-label='Net_mask' aria-describedby='basic-addon1')
                    .input-group.mb-2
                        span#basic-addon1.input-group-text(style='width:7em;') Шлюз
                        input#wlan0_gateway.form-control(type='text' aria-label='Gateway' aria-describedby='basic-addon1')
                    .input-group.mb-2
                        span#basic-addon1.input-group-text(style='width:7em;') DNS
                        input#wlan0_dns.form-control(type='text' aria-label='Gateway' aria-describedby='basic-addon1') 
    
    .card-body
        button#saveNet.btn.btn-outline-secondary(type='button' data-bs-toggle='modal' onclick = 'save_net_settings()') Сохранить

    #confirm_save_net_config_modal.modal.modal-m.fade(tabindex='-1' aria-labelledby='confirm_save_net_config_modal' aria-hidden='true' data-bs-backdrop="static")
        .modal-dialog.modal-dialog-centered
            .modal-content
                .modal-header(style='background-color: rgb(177, 220, 226);')
                    h4.confirm_save_net_config_modal_title Сохранить сетевые настройки
                .modal-body
                    h4 Устройство будет перезагружено!

                .modal-footer
                    button.btn.btn-secondary(onclick = 'save_net_config()') Ок
                    button.btn.btn-secondary(onclick = 'cancel_net_config()') Отмена

script.
    

    function save_net_config(){
        $('#confirm_save_net_config_modal').modal('hide')
        save_net_settings()
    }
    function cancel_net_config(){
        $('#confirm_save_net_config_modal').modal('hide')
    }

    //let config = !{JSON.stringify(config)}
    $( document ).ready(function() {
        $('#mDNS').val(config.net.mDNS_name)
        
        //console.log("document redy")

        if(config.net.eth0.enable ==1){
            $('#eth0_enable_toggle').bootstrapToggle('on')
        }else{
            $('#eth0_enable_toggle').bootstrapToggle('off')
        }

        if(net_info.eth0.carrier==1){
            $('#eth0_carrier').css({"color":"green"})
        }else{
            $('#eth0_carrier').css({"color":"grey"})
        }

        if(config.net.eth0.DHCP==1){
            $('#eth0_DHCP_enable_toggle').bootstrapToggle('on')
        }else{
            $('#eth0_DHCP_enable_toggle').bootstrapToggle('off')
        }
        $('#eth0_ip_adress').val(net_info.eth0.IP)
        $('#eth0_net_mask').val(net_info.eth0.net_mask)
        $('#eth0_gateway').val(net_info.eth0.gateway)
        $('#eth0_dns').val(net_info.eth0.DNS)  


        if(config.net.eth1.enable ==1){
            $('#eth1_enable_toggle').bootstrapToggle('on')
        }else{
            $('#eth1_enable_toggle').bootstrapToggle('off')
        }

        if(net_info.eth1.carrier==1){
            $('#eth1_carrier').css({"color":"green"})
        }else{
            $('#eth1_carrier').css({"color":"grey"})
        }

        if(config.net.eth1.DHCP==1){
            $('#eth1_DHCP_enable_toggle').bootstrapToggle('on')
        }else{
            $('#eth1_DHCP_enable_toggle').bootstrapToggle('off')
        }
        $('#eth1_ip_adress').val(net_info.eth1.IP)
        $('#eth1_net_mask').val(net_info.eth1.net_mask)
        $('#eth1_gateway').val(net_info.eth1.gateway)
        $('#eth1_dns').val(net_info.eth1.DNS) 


        if(config.net.wlan0.enable ==1){
            $('#wlan0_enable_toggle').bootstrapToggle('on')
        }else{
            $('#wlan0_enable_toggle').bootstrapToggle('off')
        }

        if(config.net.wlan0.DHCP==1){
            $('#wlan0_DHCP_enable_toggle').bootstrapToggle('on')
        }else{
            $('#wlan0_DHCP_enable_toggle').bootstrapToggle('off')
        }
        $('#wlan0_SSID').val(config.net.wlan0.SSID)
        $('#wlan0_password').val(config.net.wlan0.password)
        $('#wlan0_ip_adress').val(net_info.wlan0.IP)
        $('#wlan0_net_mask').val(net_info.wlan0.net_mask)
        $('#wlan0_gateway').val(net_info.wlan0.gateway)
        $('#wlan0_dns').val(net_info.wlan0.DNS)  

        // Wi-Fi connection / signal indicator. net_info.wlan0 may be absent
        // (no radio) — guard against undefined. carrier is the active AP signal
        // strength 0-100, or 0 when not associated.
        $('#wifi_sig_high').hide()
        $('#wifi_sig_mid').hide()
        $('#wifi_sig_low').hide()
        $('#wifi_sig_none').hide()
        var wifi_sig = parseInt((net_info.wlan0 || {}).carrier) || 0
        if(config.net.wlan0.enable != 1){
            // Radio disabled — show the "off" icon in grey.
            $('#wifi_sig_none').show().css({"color":"grey"})
        }else if(wifi_sig <= 0){
            // Enabled but not connected — "off" icon in red.
            $('#wifi_sig_none').show().css({"color":"red"})
        }else if(wifi_sig > 60){
            $('#wifi_sig_high').show().css({"color":"green"})
        }else if(wifi_sig > 30){
            $('#wifi_sig_mid').show().css({"color":"orange"})
        }else{
            $('#wifi_sig_low').show().css({"color":"red"})
        }



    }); 

    $('#eth0_DHCP_enable_toggle').on("change",function() {
        if($('#eth0_DHCP_enable_toggle').prop('checked') == true){
            $('#eth0_ip_adress').prop('disabled', true)
            $('#eth0_net_mask').prop('disabled', true)
            $('#eth0_gateway').prop('disabled', true)
            $('#eth0_dns').prop('disabled', true)
        }else if($('#eth0_DHCP_enable_toggle').prop('checked') == false){
            $('#eth0_ip_adress').prop('disabled', false)
            $('#eth0_net_mask').prop('disabled', false)
            $('#eth0_gateway').prop('disabled', false)
            $('#eth0_dns').prop('disabled', false)
        }
    })

    $('#eth1_DHCP_enable_toggle').on("change",function() {
        
        if($('#eth1_DHCP_enable_toggle').prop('checked') == true){
            $('#eth1_ip_adress').prop('disabled', true)
            $('#eth1_net_mask').prop('disabled', true)
            $('#eth1_gateway').prop('disabled', true)
            $('#eth1_dns').prop('disabled', true)
        }else if($('#eth1_DHCP_enable_toggle').prop('checked') == false){
            $('#eth1_ip_adress').prop('disabled', false)
            $('#eth1_net_mask').prop('disabled', false)
            $('#eth1_gateway').prop('disabled', false)
            $('#eth1_dns').prop('disabled', false)
        }
    })

    $('#wlan0_DHCP_enable_toggle').on("change",function() {
        if($('#wlan0_DHCP_enable_toggle').prop('checked') == true){
            $('#wlan0_ip_adress').prop('disabled', true)
            $('#wlan0_net_mask').prop('disabled', true)
            $('#wlan0_gateway').prop('disabled', true)
            $('#wlan0_dns').prop('disabled', true)
        }else if($('#wlan0_DHCP_enable_toggle').prop('checked') == false){
            $('#wlan0_ip_adress').prop('disabled', false)
            $('#wlan0_net_mask').prop('disabled', false)
            $('#wlan0_gateway').prop('disabled', false)
            $('#wlan0_dns').prop('disabled', false)
        }
    })

    function save_net_settings(){
        const mdnsName = $('#mDNS').val()
        if (!/^[a-z0-9][a-z0-9-]{0,62}$/.test(mdnsName)) {
            alert('Имя устройства: 1–63 символа — строчные латинские буквы, цифры, дефисы; начинаться с буквы или цифры')
            return
        }
        config.net.mDNS_name = mdnsName

        config.net.eth0.enable = +$('#eth0_enable_toggle').prop('checked')
        config.net.eth0.DHCP = +$('#eth0_DHCP_enable_toggle').prop('checked')
        config.net.eth0.IP = $('#eth0_ip_adress').val()
        config.net.eth0.net_mask = $('#eth0_net_mask').val()
        config.net.eth0.gateway = $('#eth0_gateway').val()
        config.net.eth0.DNS = $('#eth0_dns').val()

        config.net.eth1.enable = +$('#eth1_enable_toggle').prop('checked')
        config.net.eth1.DHCP = +$('#eth1_DHCP_enable_toggle').prop('checked')
        config.net.eth1.IP = $('#eth1_ip_adress').val()
        config.net.eth1.net_mask = $('#eth1_net_mask').val()
        config.net.eth1.gateway = $('#eth1_gateway').val()
        config.net.eth1.DNS = $('#eth1_dns').val()

        config.net.wlan0.enable = +$('#wlan0_enable_toggle').prop('checked')
        config.net.wlan0.SSID = $('#wlan0_SSID').val()
        config.net.wlan0.password = $('#wlan0_password').val()
        config.net.wlan0.DHCP = +$('#wlan0_DHCP_enable_toggle').prop('checked')
        config.net.wlan0.IP = $('#wlan0_ip_adress').val()
        config.net.wlan0.net_mask = $('#wlan0_net_mask').val()
        config.net.wlan0.gateway = $('#wlan0_gateway').val()
        config.net.wlan0.DNS = $('#wlan0_dns').val()

        console.log($('#eth0_enable_toggle').prop('checked'))
        fetch_save_config()
    }

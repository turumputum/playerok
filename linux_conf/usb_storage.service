[Unit]
Description=Test Service
After=multi-user.target
Conflicts=getty@tty1.service

[Service]
Environment=DISPLAY=:0
User=root
Type=simple
WorkingDirectory = /home/playerok/playerok/supervisor/
ExecStart=sudo node /home/playerok/playerok/supervisor/usb_storage.js
StandardError=append:/home/playerok/playerok/logs/usb_storage.log
StandardOutput=append:/home/playerok/playerok/logs/usb_storage.log
Restart=on-failure

[Install]
WantedBy=multi-user.target
